# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role, NOT anon. Server-only.

# Email: pick ONE transport. Leave both empty in dev and emails are logged to the console.
# (a) Gmail SMTP: sends from this Gmail address (e.g. the front desk mailbox).
#     Needs 2-step verification + an App Password on that Google account.
GMAIL_USER=resourceworkspaces@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# (b) Resend (resend.com): needs a verified sending domain.
RESEND_API_KEY=re_...
EMAIL_FROM="Resource Workspaces <bookings@resourceramp.co>"
# Display name on outgoing emails (both transports)
EMAIL_FROM_NAME=Resource Workspaces

# Front desk login for /admin
ADMIN_PASSWORD=change-me

# Public URL used in email links (Vercel sets VERCEL_URL automatically; set this once a domain is attached)
APP_URL=https://bookings.resourceramp.co

# Protects /api/cron/expire. Vercel sends it automatically when set in the project env.
CRON_SECRET=some-long-random-string
